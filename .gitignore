# =========================================================================
# Laravel & Inertia GitIgnore (Studi Kasus - BlogVerse Pro)
# =========================================================================

# Dependencies
/node_modules/
/vendor/

# Environment files
.env
.env.backup
.env.production
.env.*.local
!.env.example

# Compiled assets
/public/build/
/public/fonts-manifest.dev.json
/public/hot
/public/storage

# Storage and Cache
/storage/*.key
/storage/pail/
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*.log
!/storage/logs/.gitignore

# Test & Code Coverage Artifacts
.phpunit.result.cache
/.phpunit.cache/
/coverage-html/
/coverage.txt
/coverage.xml
/junit.xml
/events.txt
/blogverse_notices.txt
/phpunit_*.txt
/trivy-results.sarif
/.trivy-cache/
/latest-app.zip

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Databases
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor Configurations
/.codex/
/.cursor/
/.idea/
/.nova/
/.vscode/
/.zed/
*.sw?

# PHP / Composer tools
/auth.json
_ide_helper.php
.phpactor.json
Homestead.json
Homestead.yaml
